{
  "name": "frontend-tool-ai",
  "productName": "TTS Tool AI",
  "description": "Text to Speech Tool with Audio Download - AI Powered",
  "keywords": [
    "electron",
    "tts", 
    "speech",
    "text-to-speech",
    "audio-download",
    "voice-synthesis",
    "ai-tool"
  ],
  "main": "main.js",
  "version": "1.0.0",
  "author": "LeeTuaans",
  "license": "MIT",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --enable-logging",
    "build": "electron-builder",
    "dist": "electron-builder --publish=never",
    "rebuild": "electron-rebuild"
  },
  "dependencies": {
    "axios": "^1.10.0",
    "dotenv": "^17.0.0",
    "firebase": "^11.9.1",
    "lamejs": "^1.2.0",
    "wav-encoder": "^1.3.0",
    "node-wav": "^0.0.2"
  },
  "devDependencies": {
    "electron": "^35.0.0",
    "electron-builder": "^24.13.3",
    "electron-rebuild": "^3.2.9"
  },
  "build": {
    "appId": "com.leetuaans.tts-tool-ai",
    "productName": "TTS Tool AI",
    "directories": {
      "output": "dist"
    },
    "files": [
      "main.js",
      "src/**/*",
      "Javascript/**/*",
      "package.json",
      "node_modules/**/*"
    ],
    "extraResources": [
      {
        "from": "assets",
        "to": "assets",
        "filter": ["**/*"]
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": ["x64", "ia32"]
        }
      ],
      "icon": "assets/icon.ico",
      "requestedExecutionLevel": "asInvoker"
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": ["x64", "arm64"]
        }
      ],
      "icon": "assets/icon.icns",
      "category": "public.app-category.productivity"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": ["x64"]
        }
      ],
      "icon": "assets/icon.png",
      "category": "AudioVideo"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true,
      "createDesktopShortcut": true,
      "createStartMenuShortcut": true
    }
  },
  "engines": {
    "node": ">=16.0.0"
  }
}
